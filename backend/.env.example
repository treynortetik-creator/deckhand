# Deckhand Backend Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=Deckhand
DEBUG=false

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deckhand

# Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - comma-separated list of allowed frontend origins
# In production, set this to your deployed frontend URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenRouter LLM API
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_LLM_MODEL=anthropic/claude-3.5-sonnet
DEFAULT_IMAGE_MODEL=openai/dall-e-3

# Google API (for Slides export)
# Paste your Google service account JSON credentials here (single line)
GOOGLE_CREDENTIALS_JSON=

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
